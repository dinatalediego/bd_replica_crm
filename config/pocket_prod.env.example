# Server/PC only. NEVER copy these values into Android source code.

# Direct Postgres connection string of the isolated Medallio Pocket Supabase project.
POCKET_SUPABASE_DB_URL=postgresql://postgres.REPLACE_ME:REPLACE_ME@REPLACE_ME.pooler.supabase.com:5432/postgres

# Stable private HMAC key used only to turn local project codes into opaque project_ref values.
# Minimum 32 bytes. Generate a random value and keep it outside Git.
POCKET_PROJECT_HMAC_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES

# Android gets only SUPABASE_URL + sb_publishable_... from the isolated Pocket project.
# No DB URL, no HMAC key, no service_role and no sb_secret_ key may enter the APK.
