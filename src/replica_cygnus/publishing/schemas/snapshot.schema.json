{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:medallio:snapshot:1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "semantics": {
      "enum": [
        "SYNTHETIC_DEMO",
        "RECONSTRUCTED_REVISED_HISTORY"
      ]
    },
    "as_of": {
      "type": "string",
      "format": "date"
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "project": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,119}$"
          },
          "period": {
            "type": "string",
            "format": "date"
          },
          "stock_open": {
            "type": "number",
            "minimum": 0
          },
          "sales": {
            "type": "number",
            "minimum": 0
          },
          "stock_close": {
            "type": "number",
            "minimum": 0
          },
          "review_units": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "project",
          "period",
          "stock_open",
          "sales",
          "stock_close",
          "review_units"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 10000
    }
  },
  "required": [
    "schema_version",
    "source",
    "semantics",
    "as_of",
    "rows"
  ],
  "additionalProperties": false
}
