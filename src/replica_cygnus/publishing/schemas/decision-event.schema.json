{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "archive_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "decision_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,119}$"
    },
    "event_type": {
      "enum": [
        "ACTION_RECORDED",
        "OUTCOME_OBSERVED"
      ]
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "note": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "value": {
      "type": [
        "number",
        "null"
      ]
    },
    "unit": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "schema_version",
    "archive_sha256",
    "decision_id",
    "event_type",
    "occurred_at",
    "note",
    "value",
    "unit"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "OUTCOME_OBSERVED"
          }
        }
      },
      "then": {
        "properties": {
          "value": {
            "type": "number"
          },
          "unit": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  ]
}
