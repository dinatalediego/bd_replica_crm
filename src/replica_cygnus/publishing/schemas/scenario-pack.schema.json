{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:medallio:scenario-pack:1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "kind": {
      "const": "scenario"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,119}$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "classification": {
      "enum": [
        "PRIVATE",
        "SYNTHETIC"
      ]
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "provenance": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "semantics": {
          "enum": [
            "SYNTHETIC_DEMO",
            "RECONSTRUCTED_REVISED_HISTORY",
            "OBSERVED"
          ]
        },
        "as_of": {
          "type": "string",
          "format": "date"
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        },
        "dataset_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "transformation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "minItems": 1,
          "maxItems": 10000
        }
      },
      "required": [
        "source",
        "semantics",
        "as_of",
        "generated_at",
        "dataset_sha256",
        "transformation",
        "limitations"
      ],
      "additionalProperties": false
    },
    "model_pack_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,119}$"
    },
    "scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,119}$"
          },
          "model_pack_id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,119}$"
          },
          "project": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,119}$"
          },
          "multiplier": {
            "type": "number",
            "minimum": 0.5,
            "maximum": 1.5
          },
          "prediction": {
            "type": "number",
            "minimum": 0
          },
          "explanation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        },
        "required": [
          "id",
          "model_pack_id",
          "project",
          "multiplier",
          "prediction",
          "explanation"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 10000
    }
  },
  "required": [
    "schema_version",
    "kind",
    "id",
    "version",
    "classification",
    "label",
    "provenance",
    "model_pack_id",
    "scenarios"
  ],
  "additionalProperties": false
}
