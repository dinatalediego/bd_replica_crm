{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:medallio:manifest:1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "pack_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,119}$"
    },
    "pack_version": {
      "const": "1.0.0"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "classification": {
      "enum": [
        "PRIVATE",
        "SYNTHETIC"
      ]
    },
    "git_commit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "builder_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "files": {
      "type": "object",
      "minProperties": 4,
      "maxProperties": 4,
      "propertyNames": {
        "enum": [
          "data.json",
          "model.json",
          "story.json",
          "scenario.json"
        ]
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "sha256",
          "bytes"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "pack_id",
    "pack_version",
    "generated_at",
    "classification",
    "git_commit",
    "builder_sha256",
    "files"
  ],
  "additionalProperties": false
}
