{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:medallio:data-pack:1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "kind": {
      "const": "data"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,119}$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "classification": {
      "enum": [
        "PRIVATE",
        "SYNTHETIC"
      ]
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "provenance": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "semantics": {
          "enum": [
            "SYNTHETIC_DEMO",
            "RECONSTRUCTED_REVISED_HISTORY",
            "OBSERVED"
          ]
        },
        "as_of": {
          "type": "string",
          "format": "date"
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        },
        "dataset_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "transformation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "minItems": 1,
          "maxItems": 10000
        }
      },
      "required": [
        "source",
        "semantics",
        "as_of",
        "generated_at",
        "dataset_sha256",
        "transformation",
        "limitations"
      ],
      "additionalProperties": false
    },
    "question": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "grain": {
      "const": "project_month"
    },
    "dimensions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4000
      },
      "minItems": 1,
      "maxItems": 10000
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4000
      },
      "minItems": 1,
      "maxItems": 10000
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "project": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,119}$"
          },
          "period": {
            "type": "string",
            "format": "date"
          },
          "stock_open": {
            "type": "number",
            "minimum": 0
          },
          "sales": {
            "type": "number",
            "minimum": 0
          },
          "stock_close": {
            "type": "number",
            "minimum": 0
          },
          "review_units": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "project",
          "period",
          "stock_open",
          "sales",
          "stock_close",
          "review_units"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 10000
    },
    "indicators": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,119}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "value": {
            "type": "number"
          },
          "unit": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "period": {
            "type": "string",
            "format": "date"
          },
          "methodology": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        },
        "required": [
          "id",
          "name",
          "value",
          "unit",
          "period",
          "methodology"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 10000
    },
    "quality": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "PASS"
          ]
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "minItems": 1,
          "maxItems": 10000
        },
        "freshness": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        }
      },
      "required": [
        "status",
        "checks",
        "freshness"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "kind",
    "id",
    "version",
    "classification",
    "label",
    "provenance",
    "question",
    "grain",
    "dimensions",
    "metrics",
    "rows",
    "indicators",
    "quality"
  ],
  "additionalProperties": false
}
