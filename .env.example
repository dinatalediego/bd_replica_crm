# ==========================
# ORIGEN: AMAZON REDSHIFT
# ==========================
REDSHIFT_HOST=tu-cluster.xxxxxx.us-east-1.redshift.amazonaws.com
REDSHIFT_PORT=5439
REDSHIFT_DATABASE=dev
REDSHIFT_USER=usuario_lectura
REDSHIFT_PASSWORD=CAMBIAR
REDSHIFT_SSL=true
REDSHIFT_SSLMODE=verify-ca
# Tiempo máximo de espera de operaciones de socket del driver Redshift.
# 300 s evita cortar consultas válidas bajo cola/WLM o redes lentas.
REDSHIFT_SOCKET_TIMEOUT=300
REDSHIFT_TCP_KEEPALIVE=true
REDSHIFT_TCP_KEEPALIVE_IDLE=30
REDSHIFT_TCP_KEEPALIVE_INTERVAL=15
REDSHIFT_TCP_KEEPALIVE_COUNT=5
REDSHIFT_STATEMENT_TIMEOUT_MS=900000

# ==========================
# DESTINO: POSTGRESQL LOCAL
# ==========================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=medallio_dw
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CAMBIAR
POSTGRES_SSLMODE=prefer
POSTGRES_CONNECT_TIMEOUT=10

# ==========================
# EJECUCIÓN
# ==========================
APP_ENV=local
LOG_LEVEL=INFO
DEFAULT_BATCH_SIZE=5000
DEFAULT_LOOKBACK_HOURS=48
LOCK_TIMEOUT_SECONDS=5
