    "capacity_summary=pd.DataFrame([{\n",
    "    \"eligible_pool\":len(eligible_pool),\n",
    "    \"daily_capacity\":DAILY_CAPACITY,\n",
    "    \"selected\":len(policy_selected),\n",
    "    \"unserved\":max(len(eligible_pool)-DAILY_CAPACITY,0),\n",
    "    \"capacity_utilization\":(\n",
    "        len(policy_selected)/DAILY_CAPACITY\n",
    "        if DAILY_CAPACITY>0 else np.nan\n",
    "    )\n",
    "}])\n",
    "\n",
    "display(capacity_summary)\n",
    "\n",
    "if len(policy_selected):\n",
    "    print(\"Por banda\")\n",
    "    display(\n",
    "        policy_selected.groupby(\"priority_band\")\n",
    "        .size().rename(\"selected\").reset_index()\n",
    "    )\n",
