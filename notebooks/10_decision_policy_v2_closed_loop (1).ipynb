    "RECOMMENDATION_NAMESPACE=uuid.UUID(\n",
    "    \"cf5f19b8-ab81-4e17-bc0e-7b597e478e62\"\n",
    ")\n",
    "\n",
    "def recommendation_id_v2(score_id:str,policy_id:str)->str:\n",
    "    return str(uuid.uuid5(\n",
    "        RECOMMENDATION_NAMESPACE,\n",
    "        f\"{policy_id}:{score_id}\"\n",
    "    ))\n",
    "\n",
    "recommended_at=datetime.now(timezone.utc)\n",
    "expires_at=recommended_at+timedelta(hours=RECOMMENDATION_TTL_HOURS)\n",
    "\n",
    "treatment_recommendations=[]\n",
    "\n",
    "for r in treatment.itertuples():\n",
    "    rec_id=recommendation_id_v2(\n",
    "        str(r.score_id),\n",
    "        POLICY_ID\n",
    "    )\n",
    "\n",
    "    context={\n",
    "        \"semantics\":\"PROPENSITY_NOT_CAUSAL_UPLIFT\",\n",
    "        \"policy_id\":POLICY_ID,\n",
    "        \"policy_version\":POLICY_VERSION,\n",
    "        \"policy_rank\":int(r.policy_rank),\n",
    "        \"experiment_id\":EXPERIMENT_ID,\n",
    "        \"treatment_group\":\"TREATMENT\",\n",
    "        \"score_id\":str(r.score_id),\n",
    "        \"evidence_key\":str(r.evidence_key),\n",
    "        \"lead_id\":str(r.lead_id),\n",
    "        \"priority_band\":str(r.priority_band),\n",
    "        \"priority_score\":float(r.priority_score),\n",
    "        \"priority_rank\":int(r.priority_rank),\n",
    "        \"p_separacion_14d\":float(r.p_separacion_14d),\n",
    "        \"p_minuta_60d\":float(r.p_minuta_60d),\n",
    "        \"codigo_proyecto\":r.codigo_proyecto,\n",
    "        \"asesor\":r.asesor,\n",
    "        \"canal\":r.canal,\n",
    "        \"medio\":r.medio,\n",
    "        \"action_owner_proposed\":r.action_owner_proposed,\n",
    "        \"sla_minutes\":int(r.sla_minutes),\n",
    "        \"recommended_at\":recommended_at.isoformat(),\n",
    "        \"expires_at\":expires_at.isoformat(),\n",
    "    }\n",
    "\n",
    "    treatment_recommendations.append({\n",
    "        \"recommendation_id\":rec_id,\n",
    "        \"evidence_key\":str(r.evidence_key),\n",
    "        \"lead_id\":str(r.lead_id),\n",
    "        \"model_run_id\":str(r.model_run_id),\n",
    "        \"predicted_probability\":float(r.p_minuta_60d),\n",
    "        \"recommended_action\":str(r.recommended_action),\n",
    "        \"priority_rank\":int(r.policy_rank),\n",
    "        \"context_json\":context,\n",
    "    })\n",
    "\n",
    "recommendations_v2_preview=pd.DataFrame(treatment_recommendations)\n",
    "\n",
    "print(\"V2 recommendations to materialize:\",len(recommendations_v2_preview))\n",
    "display(recommendations_v2_preview.head(50))\n"
   ]
  },
