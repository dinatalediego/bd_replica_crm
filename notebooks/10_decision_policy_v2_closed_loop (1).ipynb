    "        # El experimento puede existir de una ejecución anterior.\n",
    "        ex=sql_df(\"\"\"\n",
    "        SELECT COUNT(*) n\n",
    "        FROM experiments.experiments\n",
    "        WHERE experiment_id=%s::uuid\n",
    "        \"\"\",(EXPERIMENT_ID,))\n",
    "        if int(ex.iloc[0][\"n\"])==0:\n",
    "            raise RuntimeError(\n",
    "                \"Primero crea el experimento con CREATE_EXPERIMENT=True.\"\n",
    "            )\n",
    "\n",
    "    records=[\n",
    "        (\n",
    "            EXPERIMENT_ID,\n",
    "            str(r.evidence_key),\n",
    "            str(r.treatment_group),\n",
    "        )\n",
    "        for r in policy_selected.itertuples()\n",
    "    ]\n",
    "\n",
    "    with conn.cursor() as cur:\n",
    "        cur.executemany(\"\"\"\n",
    "        INSERT INTO experiments.assignments\n",
    "          (experiment_id,entity_id,treatment_group,assigned_at)\n",
    "        VALUES (%s::uuid,%s,%s,now())\n",
    "        ON CONFLICT (experiment_id,entity_id)\n",
    "        DO UPDATE SET treatment_group=EXCLUDED.treatment_group\n",
    "        \"\"\",records)\n",
    "\n",
    "    conn.commit()\n",
    "    assignments_written=len(records)\n",
    "    print(\"Assignments written:\",assignments_written)\n",
    "else:\n",
    "    print(\"DRY RUN: assignments no escritos.\")\n"
   ]
  },
