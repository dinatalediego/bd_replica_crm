   "source": [
    "journey_v2=sql_df(\"\"\"\n",
    "SELECT\n",
    "  r.recommendation_id::text,\n",
    "  r.entity_id AS evidence_key,\n",
    "  r.context_json->>'lead_id' AS lead_id,\n",
    "  r.context_json->>'priority_band' AS priority_band,\n",
    "  (r.context_json->>'priority_score')::double precision AS priority_score,\n",
    "  (r.context_json->>'policy_rank')::integer AS policy_rank,\n",
    "  (r.context_json->>'sla_minutes')::integer AS sla_minutes,\n",
    "  r.context_json->>'action_owner_proposed' AS action_owner_proposed,\n",
    "  (r.context_json->>'recommended_at')::timestamptz AS recommended_at,\n",
    "  (r.context_json->>'expires_at')::timestamptz AS expires_at,\n",
    "  r.recommended_action,\n",
    "  a.action_id::text,\n",
    "  a.action_taken,\n",
    "  a.action_owner,\n",
    "  a.action_at,\n",
    "  a.action_cost,\n",
    "  CASE\n",
    "    WHEN a.action_id IS NULL THEN NULL\n",
    "    ELSE a.action_taken=r.recommended_action\n",
    "  END AS followed_recommendation,\n",
    "  sep.outcome_value AS separacion_14d,\n",
    "  sep.outcome_at AS separacion_observed_at,\n",
    "  minuta.outcome_value AS minuta_60d,\n",
    "  minuta.outcome_at AS minuta_observed_at\n",
    "FROM decision_intelligence.recommendations r\n",
    "LEFT JOIN LATERAL (\n",
    "  SELECT a1.*\n",
    "  FROM decision_intelligence.actions a1\n",
    "  WHERE a1.recommendation_id=r.recommendation_id\n",
    "  ORDER BY a1.action_at\n",
    "  LIMIT 1\n",
    ") a ON true\n",
    "LEFT JOIN decision_intelligence.outcomes sep\n",
    "  ON sep.decision_system=r.decision_system\n",
    " AND sep.entity_id=r.entity_id\n",
    " AND sep.outcome_name='separacion_14d'\n",
    "LEFT JOIN decision_intelligence.outcomes minuta\n",
    "  ON minuta.decision_system=r.decision_system\n",
    " AND minuta.entity_id=r.entity_id\n",
    " AND minuta.outcome_name='minuta_60d'\n",
    "WHERE r.decision_system=%s\n",
    "  AND r.context_json->>'policy_id'=%s\n",
    "ORDER BY policy_rank\n",
    "\"\"\",(DECISION_SYSTEM,POLICY_ID))\n",
    "\n",
    "if len(journey_v2):\n",
    "    for c in [\n",
    "        \"recommended_at\",\"expires_at\",\"action_at\",\n",
    "        \"separacion_observed_at\",\"minuta_observed_at\"\n",
    "    ]:\n",
    "        journey_v2[c]=pd.to_datetime(\n",
    "            journey_v2[c],utc=True,errors=\"coerce\"\n",
    "        )\n",
    "\n",
    "    journey_v2[\"minutes_to_action\"]=(\n",
    "        journey_v2[\"action_at\"]-journey_v2[\"recommended_at\"]\n",
    "    ).dt.total_seconds()/60\n",
    "\n",
    "    journey_v2[\"within_sla\"]=np.where(\n",
    "        journey_v2[\"action_at\"].notna(),\n",
    "        journey_v2[\"minutes_to_action\"]<=journey_v2[\"sla_minutes\"],\n",
    "        False\n",
    "    )\n",
    "\n",
    "print(\"V2 journeys:\",len(journey_v2))\n",
    "display(journey_v2.head(100))\n"
   ]
  },
