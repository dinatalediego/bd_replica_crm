   "source": [
    "recommendations_written=0\n",
    "\n",
    "if WRITE_RECOMMENDATIONS:\n",
    "    if not WRITE_MODE:\n",
    "        raise RuntimeError(\n",
    "            \"WRITE_RECOMMENDATIONS=True requiere WRITE_MODE=True.\"\n",
    "        )\n",
    "\n",
    "    if not bool(gates_policy[\"passed\"].all()):\n",
    "        raise RuntimeError(\"Policy readiness no está completamente PASS.\")\n",
    "\n",
    "    # Antes de recomendar treatment, exigimos assignment registrado.\n",
    "    assignment_check=sql_df(\"\"\"\n",
    "    SELECT COUNT(*) n\n",
    "    FROM experiments.assignments\n",
    "    WHERE experiment_id=%s::uuid\n",
    "      AND treatment_group='TREATMENT'\n",
    "    \"\"\",(EXPERIMENT_ID,))\n",
    "\n",
    "    if int(assignment_check.iloc[0][\"n\"])==0:\n",
    "        raise RuntimeError(\n",
    "            \"No hay treatment assignments registrados. \"\n",
    "            \"Ejecuta WRITE_ASSIGNMENTS primero.\"\n",
    "        )\n",
    "\n",
    "    records=[]\n",
    "\n",
    "    for r in treatment_recommendations:\n",
    "        records.append((\n",
    "            r[\"recommendation_id\"],\n",
    "            DECISION_SYSTEM,\n",
    "            r[\"evidence_key\"],\n",
    "            recommended_at,\n",
    "            r[\"model_run_id\"],\n",
    "            r[\"predicted_probability\"],\n",
    "            r[\"recommended_action\"],\n",
    "            r[\"priority_rank\"],\n",
    "            json.dumps(r[\"context_json\"],ensure_ascii=False),\n",
    "        ))\n",
    "\n",
    "    with conn.cursor() as cur:\n",
    "        cur.executemany(\"\"\"\n",
    "        INSERT INTO decision_intelligence.recommendations\n",
    "          (\n",
    "            recommendation_id,\n",
    "            decision_system,\n",
    "            entity_id,\n",
    "            scored_at,\n",
    "            model_run_id,\n",
    "            predicted_probability,\n",
    "            recommended_action,\n",
    "            priority_rank,\n",
    "            context_json\n",
    "          )\n",
    "        VALUES\n",
    "          (%s::uuid,%s,%s,%s,%s::uuid,%s,%s,%s,%s::jsonb)\n",
    "        ON CONFLICT (recommendation_id) DO UPDATE SET\n",
    "          predicted_probability=EXCLUDED.predicted_probability,\n",
    "          recommended_action=EXCLUDED.recommended_action,\n",
    "          priority_rank=EXCLUDED.priority_rank,\n",
    "          context_json=EXCLUDED.context_json\n",
    "        \"\"\",records)\n",
    "\n",
    "    conn.commit()\n",
    "    recommendations_written=len(records)\n",
    "    print(\"V2 recommendations written:\",recommendations_written)\n",
    "else:\n",
    "    print(\"DRY RUN: recomendaciones V2 no escritas.\")\n"
   ]
