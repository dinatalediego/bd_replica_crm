    "assignments_current=sql_df(\"\"\"\n",
    "SELECT\n",
    "  a.entity_id AS evidence_key,\n",
    "  a.treatment_group,\n",
    "  a.assigned_at\n",
    "FROM experiments.assignments a\n",
    "WHERE a.experiment_id=%s::uuid\n",
    "\"\"\",(EXPERIMENT_ID,))\n",
    "\n",
    "if len(assignments_current):\n",
    "    outcomes_current=sql_df(\"\"\"\n",
    "    SELECT\n",
    "      entity_id AS evidence_key,\n",
    "      MAX(outcome_value) FILTER (\n",
    "        WHERE outcome_name='separacion_14d'\n",
    "      ) AS separacion_14d,\n",
    "      MAX(outcome_at) FILTER (\n",
    "        WHERE outcome_name='separacion_14d'\n",
    "      ) AS separacion_observed_at,\n",
    "      MAX(outcome_value) FILTER (\n",
    "        WHERE outcome_name='minuta_60d'\n",
    "      ) AS minuta_60d,\n",
    "      MAX(outcome_at) FILTER (\n",
    "        WHERE outcome_name='minuta_60d'\n",
    "      ) AS minuta_observed_at\n",
    "    FROM decision_intelligence.outcomes\n",
    "    WHERE decision_system=%s\n",
    "    GROUP BY entity_id\n",
    "    \"\"\",(DECISION_SYSTEM,))\n",
    "\n",
    "    experiment_analysis=assignments_current.merge(\n",
    "        outcomes_current,\n",
    "        on=\"evidence_key\",\n",
    "        how=\"left\"\n",
    "    )\n",
    "else:\n",
    "    experiment_analysis=pd.DataFrame()\n",
    "\n",
    "display(experiment_analysis.head(100))\n"
   ]
