    "eligible_pool[\"band_order\"]=eligible_pool[\"priority_band\"].map(BAND_ORDER)\n",
    "\n",
    "policy_selected=(\n",
    "    eligible_pool\n",
    "    .sort_values(\n",
    "        [\"band_order\",\"priority_rank\",\"priority_score\",\"scored_at\"],\n",
    "        ascending=[True,True,False,False]\n",
    "    )\n",
    "    .head(DAILY_CAPACITY)\n",
    "    .copy()\n",
    "    .reset_index(drop=True)\n",
    ")\n",
    "\n",
    "policy_selected[\"policy_rank\"]=np.arange(1,len(policy_selected)+1)\n",
    "policy_selected[\"policy_id\"]=POLICY_ID\n",
    "policy_selected[\"policy_version\"]=POLICY_VERSION\n",
    "policy_selected[\"sla_minutes\"]=policy_selected[\"priority_band\"].map(SLA_BY_BAND)\n",
    "policy_selected[\"recommended_action\"]=policy_selected[\n",
    "    \"priority_band\"\n",
    "].map(recommended_action_for_band)\n",
    "\n",
    "policy_selected[\"action_owner_proposed\"]=(\n",
    "    policy_selected[\"asesor\"]\n",
    "    .fillna(\"SUPERVISOR_COMERCIAL\")\n",
    "    .replace(\"\", \"SUPERVISOR_COMERCIAL\")\n",
    ")\n",
    "\n",
    "print(\"Eligible pool:\",len(eligible_pool))\n",
    "print(\"Selected by capacity:\",len(policy_selected))\n",
    "\n",
    "display(policy_selected[[\n",
    "    \"policy_rank\",\"evidence_key\",\"lead_id\",\"codigo_proyecto\",\n",
    "    \"action_owner_proposed\",\"priority_band\",\"priority_rank\",\n",
    "    \"priority_score\",\"p_minuta_60d\",\"recommended_action\",\"sla_minutes\"\n",
    "]].head(100))\n"
   ]
