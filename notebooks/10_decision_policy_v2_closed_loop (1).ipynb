    "def stable_u01(policy_id:str,evidence_key:str)->float:\n",
    "    raw=f\"{policy_id}:{evidence_key}\".encode(\"utf-8\")\n",
    "    h=hashlib.sha256(raw).hexdigest()\n",
    "    return int(h[:16],16)/float(16**16-1)\n",
    "\n",
    "policy_selected[\"assignment_u\"]=policy_selected[\"evidence_key\"].map(\n",
    "    lambda x:stable_u01(POLICY_ID,str(x))\n",
    ")\n",
    "\n",
    "policy_selected[\"treatment_group\"]=np.where(\n",
    "    policy_selected[\"assignment_u\"]<TREATMENT_SHARE,\n",
    "    \"TREATMENT\",\n",
    "    \"CONTROL\"\n",
    ")\n",
    "\n",
    "assignment_summary=(\n",
    "    policy_selected.groupby(\"treatment_group\")\n",
    "    .size().rename(\"n\").reset_index()\n",
    ")\n",
    "\n",
    "assignment_summary[\"share\"]=assignment_summary[\"n\"]/max(len(policy_selected),1)\n",
    "display(assignment_summary)\n",
    "\n",
    "treatment=policy_selected[\n",
    "    policy_selected[\"treatment_group\"].eq(\"TREATMENT\")\n",
    "].copy()\n",
    "\n",
    "control=policy_selected[\n",
    "    policy_selected[\"treatment_group\"].eq(\"CONTROL\")\n",
    "].copy()\n",
    "\n",
    "print(\"Treatment:\",len(treatment))\n",
    "print(\"Control:\",len(control))\n"
   ]
