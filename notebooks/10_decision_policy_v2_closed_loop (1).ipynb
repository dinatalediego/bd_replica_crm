   "source": [
    "now_utc=pd.Timestamp.now(tz=\"UTC\")\n",
    "cutoff=now_utc-pd.Timedelta(days=MAX_LEAD_AGE_DAYS)\n",
    "\n",
    "candidates=score_universe.copy()\n",
    "\n",
    "candidates[\"eligible_band\"]=candidates[\"priority_band\"].isin(ALLOWED_BANDS)\n",
    "\n",
    "candidates[\"eligible_live\"]=(\n",
    "    candidates[\"evidence_source\"].eq(\"LIVE\")\n",
    "    if REQUIRE_LIVE\n",
    "    else True\n",
    ")\n",
    "\n",
    "candidates[\"eligible_label\"]=(\n",
    "    candidates[\"label_status\"].eq(\"PENDING\")\n",
    "    if REQUIRE_PENDING_LABEL\n",
    "    else True\n",
    ")\n",
    "\n",
    "candidates[\"eligible_age\"]=candidates[\"decision_at\"].ge(cutoff)\n",
    "\n",
    "candidates[\"eligibility_pass\"]=(\n",
    "    candidates[\"eligible_band\"]\n",
    "    & candidates[\"eligible_live\"]\n",
    "    & candidates[\"eligible_label\"]\n",
    "    & candidates[\"eligible_age\"]\n",
    ")\n",
    "\n",
    "eligibility_summary=pd.DataFrame([\n",
    "    [\"serving_scores\",len(candidates)],\n",
    "    [\"band_A_B\",int(candidates[\"eligible_band\"].sum())],\n",
    "    [\"live\",int(pd.Series(candidates[\"eligible_live\"]).sum())],\n",
    "    [\"pending_label\",int(pd.Series(candidates[\"eligible_label\"]).sum())],\n",
    "    [\"recent\",int(candidates[\"eligible_age\"].sum())],\n",
    "    [\"all_eligibility\",int(candidates[\"eligibility_pass\"].sum())],\n",
    "],columns=[\"stage\",\"rows\"])\n",
    "\n",
    "display(eligibility_summary)\n",
    "\n",
    "eligible_pool=candidates[candidates[\"eligibility_pass\"]].copy()\n"
   ]
  },
