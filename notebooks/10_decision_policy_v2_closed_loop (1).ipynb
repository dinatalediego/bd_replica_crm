   "source": [
    "recommendations_v2=sql_df(\"\"\"\n",
    "SELECT\n",
    "  recommendation_id::text,\n",
    "  entity_id AS evidence_key,\n",
    "  scored_at,\n",
    "  model_run_id::text,\n",
    "  predicted_probability,\n",
    "  recommended_action,\n",
    "  priority_rank,\n",
    "  context_json->>'policy_id' AS policy_id,\n",
    "  context_json->>'policy_version' AS policy_version,\n",
    "  context_json->>'experiment_id' AS experiment_id,\n",
    "  context_json->>'treatment_group' AS treatment_group,\n",
    "  context_json->>'lead_id' AS lead_id,\n",
    "  context_json->>'priority_band' AS priority_band,\n",
    "  (context_json->>'priority_score')::double precision AS priority_score,\n",
    "  (context_json->>'sla_minutes')::integer AS sla_minutes,\n",
    "  context_json->>'action_owner_proposed' AS action_owner_proposed,\n",
    "  (context_json->>'recommended_at')::timestamptz AS recommended_at,\n",
    "  (context_json->>'expires_at')::timestamptz AS expires_at\n",
    "FROM decision_intelligence.recommendations\n",
    "WHERE decision_system=%s\n",
    "  AND context_json->>'policy_id'=%s\n",
    "ORDER BY priority_rank,scored_at DESC\n",
    "\"\"\",(DECISION_SYSTEM,POLICY_ID))\n",
    "\n",
    "print(\"Persisted V2 recommendations:\",len(recommendations_v2))\n",
    "display(recommendations_v2.head(100))\n"
   ]
  },
