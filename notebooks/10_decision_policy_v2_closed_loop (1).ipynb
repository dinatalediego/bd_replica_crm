    "existing_v2=sql_df(\"\"\"\n",
    "SELECT\n",
    "  recommendation_id::text,\n",
    "  entity_id AS evidence_key,\n",
    "  scored_at,\n",
    "  recommended_action,\n",
    "  priority_rank,\n",
    "  context_json\n",
    "FROM decision_intelligence.recommendations\n",
    "WHERE decision_system=%s\n",
    "  AND context_json->>'policy_id'=%s\n",
    "ORDER BY scored_at DESC\n",
    "\"\"\",(DECISION_SYSTEM,POLICY_ID))\n",
    "\n",
    "print(\"Existing V2 recommendations:\",len(existing_v2))\n",
    "\n",
    "active_v2_keys=set()\n",
    "\n",
    "if len(existing_v2):\n",
    "    for _,r in existing_v2.iterrows():\n",
    "        ctx=r[\"context_json\"] if isinstance(r[\"context_json\"],dict) else {}\n",
    "        expires_raw=ctx.get(\"expires_at\")\n",
    "\n",
    "        if expires_raw:\n",
    "            expires_at=pd.to_datetime(expires_raw,utc=True,errors=\"coerce\")\n",
    "            if pd.notna(expires_at) and expires_at>now_utc:\n",
    "                active_v2_keys.add(r[\"evidence_key\"])\n",
    "\n",
    "eligible_pool[\"has_active_v2_recommendation\"]=eligible_pool[\n",
    "    \"evidence_key\"\n",
    "].isin(active_v2_keys)\n",
    "\n",
    "eligible_pool=eligible_pool[\n",
    "    ~eligible_pool[\"has_active_v2_recommendation\"]\n",
    "].copy()\n",
    "\n",
    "print(\"Eligible after active-rec exclusion:\",len(eligible_pool))\n"
   ]
  },
